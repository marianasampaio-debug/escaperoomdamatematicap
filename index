<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Escape Room — Pistas Secretas</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Trebuchet MS,Arial;color:#fff8e9;background:radial-gradient(circle at 50% 10%,#20527d,#08172d 58%,#020812);min-height:100vh}
header{text-align:center;padding:22px 12px 8px}h1{margin:0;color:#ffd45c;font-size:clamp(26px,5vw,46px);text-shadow:0 4px #7d3907,0 0 18px #ffb400}header p{color:#ffedc0}.wrap{max-width:900px;margin:auto;padding:12px}.top,.card{border:2px solid #c88b36;border-radius:18px;background:linear-gradient(#513019,#25130d);padding:16px}.top{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}.track{display:flex;gap:5px;flex-wrap:wrap}.step{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;background:#594536;border:1px solid #d5a15a;font-size:13px}.step.done{background:#2a9e63}.step.current{outline:3px solid #ffdb6e}
.card{margin-top:15px;background:linear-gradient(135deg,#fff0c5,#dba65c);color:#3a1d08;padding:clamp(18px,4vw,30px);box-shadow:0 10px 0 #6b3515}.ribbon{display:inline-block;background:#49230f;color:#ffe7a3;border:2px solid #e5ad4e;border-radius:10px;padding:8px 12px;font-weight:bold}h2{color:#682c0c;margin:14px 0;font-size:clamp(22px,4vw,31px)}.story{background:#fff8df;border-radius:12px;padding:13px;font-size:17px;line-height:1.5}.question{font-size:clamp(19px,3vw,24px);font-weight:800;line-height:1.5;margin:18px 0}input{padding:14px;border:3px solid #9c5c21;border-radius:10px;font-size:21px;width:min(100%,400px);margin:10px 0;background:#fffaf0;color:#321707;text-align:center}button{border:0;border-radius:11px;padding:13px 18px;font-weight:900;font-size:16px;cursor:pointer;margin:5px}.go{background:linear-gradient(#39d18a,#11834f);color:white}.hintbtn{background:#6b3a18;color:#ffe9b2}.next{background:#126fbd;color:white}.feedback{font-weight:bold;min-height:28px;margin:8px 0;font-size:17px}.good{color:#08743f}.bad{color:#a71927}.hint,.solution{display:none;padding:12px;border-radius:9px;margin:10px 0;background:#fff9df;border-left:5px solid #e5a323;line-height:1.5}.solution{border-left-color:#16985c}.digitReveal{display:none;text-align:center;padding:15px;background:#2b180d;color:#ffdf77;border:2px dashed #b87925;border-radius:14px;margin:12px 0}.digitReveal .digit{font-size:48px;font-weight:900;letter-spacing:5px}.final{display:none;text-align:center}.final h2{color:#8a3c0b}.treasure{display:none;font-size:70px}.footer{text-align:center;padding:20px;color:#c8d7ed}
</style></head><body>
<header><h1>🏴‍☠️ ESCAPE ROOM MATEMÁTICO</h1><p><b>O COFRE DAS PORCENTAGENS — PISTAS SECRETAS</b></p><p>Resolva, confira o cálculo e ANOTE o dígito conquistado. Não haverá lista de dígitos na tela!</p></header>
<div class="wrap"><div class="top"><b>🗝️ Fases: <span id="count">0/10</span></b><div class="track" id="track"></div><b>📓 Anote cada pista!</b></div>
<section class="card" id="game"><span class="ribbon" id="phase">FASE 1/10</span><h2 id="title"></h2><div class="story" id="story"></div><div class="question" id="question"></div><label><b>Digite sua resposta:</b></label><br><input id="answer" autocomplete="off" inputmode="decimal" placeholder="Resposta numérica ou fração"><div><button class="go" id="check">🔐 Conferir</button><button class="hintbtn" id="hintBtn">💡 Pedir pista</button></div><div class="feedback" id="feedback"></div><div class="hint" id="hint"></div><div class="solution" id="solution"></div><div class="digitReveal" id="reveal"><b>🧩 PISTA CONQUISTADA — ANOTE NO PAPEL!</b><div class="digit" id="digit"></div><p>Este dígito não ficará guardado na tela. Registre-o e avance!</p></div><button class="next" id="next" style="display:none">Anotei! Próxima fase ➜</button></section>
<section class="card final" id="final"><div style="font-size:70px">🗺️🔒</div><h2>AS 10 PISTAS FORAM CONQUISTADAS!</h2><div class="story">Agora organize os dígitos na ordem em que apareceram no seu papel e digite a senha de 10 caracteres. Atenção: a senha não será mostrada aqui!</div><br><input id="finalPass" placeholder="Digite a senha secreta" autocomplete="off" inputmode="numeric" maxlength="10"><br><button class="go" id="open">🔓 Abrir o cofre</button><div class="feedback" id="finalMsg"></div><div class="treasure" id="win">🎉🏆💰💎<h2>TESOURO DESBLOQUEADO!</h2><p style="font-size:22px">Parabéns, equipe matemática!</p></div></section></div><div class="footer">📜 Cada fase revela uma pista. Guarde todas com atenção!</div>
<script>
const stages=[
{t:"O mapa escondido",s:"A porta antiga exige o valor de uma porcentagem. Leia atentamente.",q:"Quanto é 30% de 240?",a:["72"],hint:"30% = 30/100 = 0,30. Multiplique 240 × 0,30.",calc:"30% = 30/100 = 0,30. Então: 240 × 0,30 = 72.",d:"7"},
{t:"A fração do pirata",s:"O mapa mostra uma porcentagem. Simplifique a fração para descobrir a pista.",q:"Escreva 25% como fração irredutível (formato a/b).",a:["1/4"],hint:"25% = 25/100. Simplifique dividindo por 25.",calc:"25% = 25/100. Dividindo numerador e denominador por 25: 1/4.",d:"1"},
{t:"O código decimal",s:"O guardião só aceita a representação decimal da porcentagem.",q:"Escreva 8% na forma decimal.",a:["0,08","0.08"],hint:"Divida 8 por 100; a vírgula anda duas casas para a esquerda.",calc:"8% = 8/100 = 0,08.",d:"0"},
{t:"A loja do tesouro",s:"Uma etiqueta de promoção está presa ao cadeado. Descubra o preço após o desconto.",q:"Uma bússola custa R$ 150 e tem 20% de desconto. Qual é o preço final?",a:["120","120,00","120.00"],hint:"Calcule 20% de 150 e subtraia do preço inicial.",calc:"Desconto: 150 × 0,20 = 30. Preço final: 150 − 30 = R$ 120.",d:"1"},
{t:"A embarcação valorizada",s:"O capitão aumentou o preço do barco. Descubra o novo valor.",q:"Um barco custa R$ 800 e sofre aumento de 15%. Qual é o novo preço?",a:["920","920,00","920.00"],hint:"Calcule 15% de 800 e some ao preço inicial.",calc:"Aumento: 800 × 0,15 = 120. Novo preço: 800 + 120 = R$ 920.",d:"9"},
{t:"O cadeado do desconto duplo",s:"O segundo desconto incide sobre o preço já reduzido, não sobre o original!",q:"Uma mochila de R$ 200 recebe 10% de desconto e depois 20% sobre o preço reduzido. Qual é o preço final?",a:["144","144,00","144.00"],hint:"Primeiro desconto: 10% de 200. Depois calcule 20% do valor restante.",calc:"1º: 200 − 20 = 180. 2º: 20% de 180 = 36. Final: 180 − 36 = R$ 144.",d:"1"},
{t:"A torre dos aumentos",s:"A passagem exige dois aumentos sucessivos. O segundo usa o novo preço!",q:"Um mapa custa R$ 100. Aumenta 10% e depois 20% sobre o novo preço. Qual é o preço final?",a:["132","132,00","132.00"],hint:"Após 10%, o preço vira 110. Calcule 20% de 110.",calc:"1º: 100 + 10 = 110. 2º: 20% de 110 = 22. Final: 110 + 22 = R$ 132.",d:"3"},
{t:"A fração em porcentagem",s:"Transforme a fração em porcentagem para abrir o portão.",q:"A fração 3/4 corresponde a quantos por cento?",a:["75","75%"],hint:"Faça 3 ÷ 4 e multiplique o resultado por 100.",calc:"3 ÷ 4 = 0,75. 0,75 × 100 = 75%.",d:"7"},
{t:"O número decimal mágico",s:"O guardião trabalha com números decimais. Converta corretamente!",q:"O número decimal 0,35 corresponde a quantos por cento?",a:["35","35%"],hint:"Multiplique 0,35 por 100.",calc:"0,35 × 100 = 35%.",d:"3"},
{t:"O cofre final",s:"Última mensagem: primeiro desconto, depois acréscimo sobre o valor descontado.",q:"Um tesouro de R$ 500 recebe desconto de 20% e depois acréscimo de 10% sobre o valor descontado. Qual é o valor final?",a:["440","440,00","440.00"],hint:"Após desconto, o valor fica 400. Aplique 10% sobre 400.",calc:"Desconto: 500 × 0,80 = 400. Acréscimo: 400 × 0,10 = 40. Final: 400 + 40 = R$ 440.",d:"4"}
];
let i=0,done=[],enteredDigits=[];
const $=id=>document.getElementById(id);
function track(){$("track").innerHTML=stages.map((_,n)=>`<span class="step ${done.includes(n)?'done':n===i?'current':''}">${done.includes(n)?"✓":n+1}</span>`).join("")}
function render(){let x=stages[i];$("phase").textContent=`FASE ${i+1}/10`;$("title").textContent=x.t;$("story").textContent="📜 "+x.s;$("question").textContent=x.q;$("answer").value="";$("answer").disabled=false;$("check").style.display="inline-block";$("next").style.display="none";$("feedback").textContent="";$("feedback").className="feedback";$("hint").textContent="💡 "+x.hint;$("hint").style.display="none";$("hintBtn").disabled=false;$("solution").style.display="none";$("reveal").style.display="none";$("count").textContent=done.length+"/10";track()}
function norm(v){return String(v).trim().toLowerCase().replace(/\s/g,"").replace(",",".")}
$("check").onclick=()=>{let x=stages[i],v=norm($("answer").value),ok=x.a.some(a=>norm(a)===v);if(ok){if(!done.includes(i)){done.push(i);enteredDigits[i]=x.d} $("feedback").textContent="✅ Resposta correta! Veja o cálculo e anote o dígito da pista."; $("feedback").className="feedback good";$("answer").disabled=true;$("check").style.display="none";$("solution").textContent="🧮 Resolução: "+x.calc;$("solution").style.display="block";$("digit").textContent=x.d;$("reveal").style.display="block";$("next").style.display="inline-block";$("count").textContent=done.length+"/10";track()}else{$("feedback").textContent="🔒 Ainda não! Releia a mensagem e tente novamente. Você pode pedir uma pista.";$("feedback").className="feedback bad"}};
$("hintBtn").onclick=()=>{$("hint").style.display="block";$("hintBtn").disabled=true};$("answer").addEventListener("keydown",e=>{if(e.key==="Enter")$("check").click()});
$("next").onclick=()=>{if(i<9){i++;render()}else{$("game").style.display="none";$("final").style.display="block";$("finalPass").focus()}};
$("open").onclick=()=>{let pass=enteredDigits.join("");if($("finalPass").value.trim()===pass){$("finalMsg").textContent="🔓 SENHA CORRETA! O tesouro é seu!";$("finalMsg").className="feedback good";$("win").style.display="block";$("open").style.display="none";$("finalPass").disabled=true}else{$("finalMsg").textContent="❌ Senha incorreta. Confira os dígitos anotados e a ordem das pistas.";$("finalMsg").className="feedback bad"}};
$("finalPass").addEventListener("keydown",e=>{if(e.key==="Enter")$("open").click()});render();
</script></body></html>
